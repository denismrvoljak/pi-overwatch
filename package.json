{
  "name": "agentwatch",
  "version": "0.2.0",
  "description": "Bring all your agent activity into one place. A local status board for Pi, Claude Code, and Codex: TUI dashboard, tmux status line, and session titles.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "agentwatch",
    "dashboard",
    "observability",
    "tmux",
    "tui",
    "claude-code",
    "codex"
  ],
  "bin": {
    "agentwatch": "./bin/agentwatch.js",
    "pi-overwatch": "./bin/pi-overwatch.js"
  },
  "scripts": {
    "test": "node --test bin/*.test.js hooks/*.test.js"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "README.md",
    "LICENSE",
    "bin",
    "extensions",
    "hooks",
    "examples",
    "config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denismrvoljak/agentwatch.git"
  },
  "homepage": "https://github.com/denismrvoljak/agentwatch",
  "bugs": {
    "url": "https://github.com/denismrvoljak/agentwatch/issues"
  },
  "license": "MIT"
}
